# ═══════════════════════════════════════════════════════════════
#  loop v2 — variables d'environnement (EXEMPLE — copier vers .dev.vars)
# ═══════════════════════════════════════════════════════════════
#  Backend (Cloudflare Workers) : utilisez `.dev.vars` en local et
#  `wrangler secret put <NOM>` en production. Ne commitez JAMAIS ce
#  fichier rempli avec de vraies valeurs.
#
#  Frontend (Vite) : préfixez par VITE_ dans `frontend/.env.local`.
# ═══════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-string

# ── Wallets (banque) ──────────────────────────────────────────
# PAYTO reçoit tout (clé JAMAIS sur le serveur — adresse seule).
PAYTO_ADDRESS=0x0000000000000000000000000000000000000000
OPS_ADDRESS=0x0000000000000000000000000000000000000000
SPEND_ADDRESS=0x0000000000000000000000000000000000000000
# Clé SPEND chiffrée ou via Workers secrets — plafond strict.
# SPEND_PRIVATE_KEY=(wrangler secret put SPEND_PRIVATE_KEY)

# ── Policy ────────────────────────────────────────────────────
# Plafond de sortie SPEND / jour avant HITL obligatoire (USDC).
DAILY_SPEND_LIMIT_USDC=1
# Marge nette minimale F2 pour proposer un deal (€).
F2_MIN_MARGIN_EUR=15
# Réserve litige F2 (fraction, 0.10 = 10 %).
F2_LITIGATION_RESERVE_RATE=0.10
# Top-N missions proposées à chaque cycle.
SCAN_TOP_N=5

# ── Connecteurs (optionnels — lecture seule par défaut) ───────
GITHUB_TOKEN=
ALGORA_API_KEY=
GITCOIN_API_KEY=
DEWORK_API_KEY=
X402_BAZAAR_URL=https://bazaar.example.com
RENTAHUMAN_API_KEY=

# ── Frontend ──────────────────────────────────────────────────
# Dans frontend/.env.local :
# VITE_API_URL=http://localhost:8787
# VITE_MOCK_FALLBACK=true
