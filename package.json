{
  "name": "loop-agent",
  "version": "2.0.0",
  "description": "loop v2 — agent chasseur de missions rémunérées (F1) + arbitrage humain (F2). Cloudflare Workers + Hono + D1 + Telegram.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply loop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply loop-db --remote",
    "seed:local": "wrangler d1 execute loop-db --local --file=./migrations/0002_seed_platform_rules.sql",
    "seed:remote": "wrangler d1 execute loop-db --remote --file=./migrations/0002_seed_platform_rules.sql",
    "telegram:webhook": "tsx scripts/set-telegram-webhook.ts"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "d1",
    "x402",
    "ai-agent",
    "freelance",
    "arbitrage"
  ],
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3",
    "wrangler": "^3.78.0"
  }
}
